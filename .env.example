# Public production mode uses SEC, Nasdaq and FINRA read-only routes.
DATA_MODE=OFFICIAL

# Local-only endpoint created by scripts/start-vibe-tunnel.sh.
# Never expose the remote MCP server directly to the public internet.
VIBE_MCP_URL=http://127.0.0.1:18900/mcp
VIBE_MCP_AUTH_TOKEN=

# Nasdaq EPS consensus is the built-in default. Override only when using an
# equivalent licensed provider or a compatible proxy.
CONSENSUS_PROVIDER_URL=https://api.nasdaq.com/api/analyst

# Update after NVIDIA publishes the next official earnings event date. The
# options adapter fails closed when this date becomes stale.
NVDA_NEXT_EARNINGS_DATE=2026-08-26

# SEC requests require a descriptive user agent with a real contact.
SEC_USER_AGENT=YourCompany research@example.com
